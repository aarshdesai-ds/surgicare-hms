# Copy to .env and fill in from your Supabase project (Settings → API / Database).
# NEVER commit the real .env.

# Postgres connection string (Settings → Database → Connection string → URI).
# Use the "Session" pooler URI for a long-running API. Example:
# postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase JWT secret (Settings → API → JWT Settings → JWT Secret).
# Used to verify access tokens issued by Supabase Auth.
SUPABASE_JWT_SECRET=change-me-super-secret

# Project URL + service role key (Settings → API). Service role bypasses RLS —
# keep it server-side only, never expose to the browser.
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key

# App config
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of allowed CORS origins (the React app)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Razorpay (online payments) ---------------------------------------------
# From the Razorpay Dashboard → Settings → API Keys. Use rzp_test_* keys while
# testing; switch to rzp_live_* for production. Leave blank to disable online
# payments (the app falls back to manual cash/card/UPI entry).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → the secret you set when adding the webhook.
# Required only if you configure the payment_link.paid webhook (recommended for
# production; in local/test you can use the "Check status" poll instead).
RAZORPAY_WEBHOOK_SECRET=
# Where a payer's browser returns after paying (any page in your app is fine).
RAZORPAY_CALLBACK_URL=http://localhost:5173/billing

# --- Pharmacy bridge -------------------------------------------------------
# Shared secret the offline pharmacy-PC agent uses to pull pending
# prescriptions and mark them delivered. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Put the SAME value in the bridge's own .env (pharmacy-bridge/.env).
# Leave blank to disable the bridge endpoints entirely.
PHARMACY_BRIDGE_TOKEN=

# Optional — enables the integration test suite (pytest). Each test runs inside
# a transaction that is rolled back, so pointing this at your Supabase DB is
# safe (use a separate test project if you prefer). Leave unset to skip them.
# TEST_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
