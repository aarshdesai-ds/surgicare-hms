# Copy to .env and fill in from your Supabase project (Settings -> API).
# Vite only exposes vars prefixed with VITE_ to the browser.

# Project URL (Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://atohgsprqqwfujghjyky.supabase.co

# Publishable key (Settings -> API Keys -> Publishable key, starts with sb_publishable_)
# Safe to use in the browser because Row-Level Security is enabled.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Your FastAPI backend
VITE_API_BASE_URL=http://127.0.0.1:8000
