# Copy to .env (in this folder) and fill in. NEVER commit the real .env.

# Base URL of the HMS backend the pharmacy PC can reach (LAN IP or public URL).
# The pharmacy PC only needs OUTBOUND access to this — it is never contacted.
HMS_API_URL=http://192.168.1.50:8000

# Must exactly match PHARMACY_BRIDGE_TOKEN set in the HMS backend .env.
PHARMACY_BRIDGE_TOKEN=

# Folder where prescription files are written for Visual Chemist to import.
# Point Visual Chemist's import at this folder (or process it manually).
OUTPUT_DIR=C:\SurgiCare\pharmacy-inbox

# Which file(s) to write per prescription: csv, json, or both.
FILE_FORMATS=csv,json

# How often to check for new prescriptions, in seconds.
POLL_SECONDS=15
